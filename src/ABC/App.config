<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<connectionStrings>
		<add name="QUANLICHTL"
			connectionString="Data Source=.;Initial Catalog=QLCH;Integrated Security=True;TrustServerCertificate=True;"
			 providerName="System.Data.SqlClient" />
	</connectionStrings>
	<appSettings>
		<!-- Gmail: bật xác minh 2 bước rồi tạo "Mật khẩu ứng dụng" (App password) 16 ký tự -->
		<add key="SmtpHost" value="smtp.gmail.com" />
		<add key="SmtpPort" value="587" />
		<add key="SmtpUser" value="your_email@gmail.com" />
		<add key="SmtpPassword" value="your_app_password" />
	</appSettings>
</configuration>